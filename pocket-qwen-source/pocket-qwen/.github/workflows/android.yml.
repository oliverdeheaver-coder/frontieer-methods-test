name: Build APK

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:
  release:
    types: [published]

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 90
    defaults:
      run:
        working-directory: pocket-qwen-source/pocket-qwen
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - uses: android-actions/setup-android@v3

      - name: Install NDK and CMake
        run: sdkmanager --install "ndk;29.0.13113456" "cmake;3.31.6" "platforms;android-36" "build-tools;36.0.0"

      - uses: gradle/actions/setup-gradle@v4

      - name: Cache native build
        uses: actions/cache@v4
        with:
          path: pocket-qwen-source/pocket-qwen/app/.cxx
          key: cxx-${{ hashFiles('pocket-qwen-source/pocket-qwen/app/src/main/cpp/**', 'pocket-qwen-source/pocket-qwen/app/build.gradle.kts') }}-${{ github.sha }}
          restore-keys: cxx-${{ hashFiles('pocket-qwen-source/pocket-qwen/app/src/main/cpp/**', 'pocket-qwen-source/pocket-qwen/app/build.gradle.kts') }}-

      - name: Build release APK
        run: |
          chmod +x gradlew
          ./gradlew --no-daemon assembleRelease

      - name: Rename APK
        run: cp app/build/outputs/apk/release/app-release.apk PocketQwen-${{ github.event.release.tag_name || 'latest' }}.apk
        shell: bash

      - uses: actions/upload-artifact@v4
        with:
          name: PocketQwen-apk
          path: pocket-qwen-source/pocket-qwen/PocketQwen-*.apk

      - name: Publish GitHub Release
        if: github.event_name == 'release'
        uses: softprops/action-gh-release@v2
        with:
          files: pocket-qwen-source/pocket-qwen/PocketQwen-*.apk
          tag_name: ${{ github.event.release.tag_name }}
